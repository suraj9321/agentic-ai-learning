# Copy this file to .env  (cp .env.example .env) and fill in your values.
# .env is in .gitignore so your keys never get committed.

# --- Required for Week 1 -------------------------------------------------
# Get a key at https://platform.claude.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Which model the lessons use. Default is Claude Opus 5.5 ($4 / $20 per 1M tokens).
# Cheaper options if you want to save money while practising:
#   claude-sonnet-5-5  ($2 / $10)     claude-haiku-5-5  ($0.10 / $0.50)
MODEL=claude-opus-5-5

# --- Needed from Week 3 (LangSmith tracing) — free account at smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agentic-ai-learning

# --- Tracing (how much the lessons print about each LLM call) ---------------
# TRACE=full   → every request/response in detail (default; best for learning)
# TRACE=brief  → one line per call / tool run
# TRACE=off    → only the lesson's own prints
TRACE=full
# Long texts are cut to this many characters in traces (0 = never cut)
TRACE_MAX_CHARS=500
